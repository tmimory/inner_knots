# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.
# Every variable the app reads belongs here with a placeholder, so others know what to provide.
#
# Variables prefixed EXPO_PUBLIC_ are bundled into the client and visible to anyone with the app.
# Only put a value there if the provider considers it safe to expose.
#
# Everything else is read only inside Expo Router API routes (app/api/**+api.ts), which run in
# Node on the dev server, so no key ever reaches the browser bundle.

# --- Model providers -------------------------------------------------------------------
# A provider is enabled when its key is present; leave a key blank to hide that provider.

# Anthropic API key for running puzzles against Claude models. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key for GPT models. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# TypeSafe API key for System One (Jev) typed judgments. See https://docs.typesafe.ai
TYPESAFE_API_KEY=

# OpenRouter API key, for reaching many models through one endpoint. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Local models ----------------------------------------------------------------------

# Base URL of a local OpenAI-compatible server (Ollama, LM Studio, llama.cpp, vLLM).
# Ollama exposes this by default; `ollama serve` then use http://localhost:11434/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Optional token for the local server. Most local servers ignore it; set it if yours requires one.
LOCAL_LLM_API_KEY=

# --- Run defaults ----------------------------------------------------------------------

# Hard clamp on output tokens for every provider call, so models cannot overthink a choice.
MAX_OUTPUT_TOKENS=1024

# Default reasoning effort when a character does not set its own: low | medium | high.
DEFAULT_EFFORT=low

# How many decisions the run engine keeps in flight at once. Raise it for a fast remote
# provider, lower it to 1 for a local model that serves one request at a time. Capped at 16.
RUN_CONCURRENCY=3

# Directory for the local JSONL stores (characters, objects, adventures, runs, spans, logs).
# Relative to the repo root. Created on first write and gitignored.
DATA_DIR=./data

# --- Client ----------------------------------------------------------------------------

# Absolute base URL of the API routes, used only by native builds (web uses a relative path).
# Set it to the LAN address `expo start` prints when running the app on a device.
# Safe to ship in the client bundle: it is an address, not a secret.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8081
